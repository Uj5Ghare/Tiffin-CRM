# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Keystore passwords for signing the app
# DEBUG_STORE_PASSWORD: Password for debug keystore (default: android)
DEBUG_STORE_PASSWORD=android
# DEBUG_KEY_PASSWORD: Password for debug key (default: android)
DEBUG_KEY_PASSWORD=android
# STORE_PASSWORD: Password for release keystore (set via environment variable)
# STORE_PASSWORD=
# KEY_PASSWORD: Password for release key (set via environment variable)
# KEY_PASSWORD=
